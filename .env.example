# Copy to .env and fill in to enable the production backend.

# "tfidf" (default, zero setup) or "chroma" (real embeddings, needs the deps below)
VECTOR_BACKEND=tfidf

# Only used when VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=books
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional: enables the LLM re-ranking/explanation agent.
# Without this, the system runs fine using a deterministic fallback agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

DEFAULT_TOP_K=5
DEFAULT_CANDIDATE_K=15
